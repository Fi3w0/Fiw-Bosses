      "abilities": [
        { "type": "blink_strike", "cooldownTicks": 60, "params": { "damage": 8 } },
        { "type": "pull", "cooldownTicks": 100, "params": {} }
      ]
    },
    "boated": {
      "durationSeconds": 20,
      "speedMultiplier": 1.5,
      "transitionMessage": "&cA boat? Really?"
    },
    "timer": {
      "afterSeconds": 300,
