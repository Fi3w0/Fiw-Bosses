      "abilities": [
        { "type": "teleport", "cooldownTicks": 80, "params": {} },
        { "type": "beam", "cooldownTicks": 120, "params": { "damage": 6, "particle": "minecraft:portal" } },
        { "type": "gravity_well", "cooldownTicks": 200, "params": {} }
      ]
